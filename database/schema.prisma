// =============================================================================
// MediCore - Prisma Schema
// Hospital, Appointment & Patient Care Management Platform
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTHENTICATION & AUTHORIZATION
// =============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  patient       Patient?
  staff         Staff?
  auditLogs     AuditLog[]       @relation("AuditActor")
  notifications Notification[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  family    String   @db.VarChar(100)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy String?  @map("revoked_by") @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@map("refresh_tokens")
}

// =============================================================================
// PATIENTS
// =============================================================================

model Patient {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  registrationNumber  String   @unique @map("registration_number") @db.VarChar(20)
  dateOfBirth         DateTime @map("date_of_birth") @db.Date
  gender              String   @db.VarChar(20)
  bloodType           String?  @map("blood_type") @db.VarChar(5)
  address             String?  @db.Text
  city                String?  @db.VarChar(100)
  state               String?  @db.VarChar(100)
  postalCode          String?  @map("postal_code") @db.VarChar(20)
  country             String?  @db.VarChar(100)
  allergies           String?  @db.Text
  medicalNotes        String?  @map("medical_notes") @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  registeredAt        DateTime @default(now()) @map("registered_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts          PatientContact[]
  appointments      Appointment[]
  encounters        Encounter[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  invoices          Invoice[]
  consents          Consent[]

  @@index([registrationNumber])
  @@index([dateOfBirth])
  @@map("patients")
}

model PatientContact {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  contactType  String   @map("contact_type") @db.VarChar(20) // EMERGENCY, NEXT_OF_KIN, GUARDIAN
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  relationship String   @db.VarChar(50)
  phone        String   @db.VarChar(20)
  email        String?  @db.VarChar(255)
  address      String?  @db.Text
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_contacts")
}

// =============================================================================
// STAFF & DEPARTMENTS
// =============================================================================

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  headId      String?  @map("head_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  staff Staff[]

  @@map("departments")
}

model Staff {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  employeeId      String   @unique @map("employee_id") @db.VarChar(20)
  departmentId    String   @map("department_id") @db.Uuid
  specialization  String?  @db.VarChar(100)
  qualification   String?  @db.VarChar(255)
  licenseNumber   String?  @map("license_number") @db.VarChar(50)
  joiningDate     DateTime @map("joining_date") @db.Date
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department        @relation(fields: [departmentId], references: [id])
  schedules       DoctorSchedule[]
  appointments    Appointment[]     @relation("DoctorAppointments")
  encounters      Encounter[]       @relation("DoctorEncounters")
  prescriptions   Prescription[]    @relation("PrescriberRelation")

  @@index([departmentId])
  @@index([specialization])
  @@map("staff")
}

model DoctorSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") // 0=Sunday, 6=Saturday
  startTime   String   @map("start_time") @db.VarChar(5) // HH:MM format
  endTime     String   @map("end_time") @db.VarChar(5)
  slotDuration Int     @default(30) @map("slot_duration") // minutes
  isActive    Boolean  @default(true) @map("is_active")
  validFrom   DateTime @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
  @@map("doctor_schedules")
}

// =============================================================================
// APPOINTMENTS
// =============================================================================

model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  doctorId        String   @map("doctor_id") @db.Uuid
  departmentId    String?  @map("department_id") @db.Uuid
  scheduledStart  DateTime @map("scheduled_start") @db.Timestamptz
  scheduledEnd    DateTime @map("scheduled_end") @db.Timestamptz
  status          String   @default("REQUESTED") @db.VarChar(20)
  type            String   @default("CONSULTATION") @db.VarChar(30)
  reason          String?  @db.Text
  notes           String?  @db.Text
  checkedInAt     DateTime? @map("checked_in_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy     String?  @map("cancelled_by") @db.Uuid
  cancellationReason String? @map("cancellation_reason") @db.Text
  priority        Int      @default(0)
  idempotencyKey  String?  @unique @map("idempotency_key") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient    Patient     @relation(fields: [patientId], references: [id])
  doctor     Staff       @relation("DoctorAppointments", fields: [doctorId], references: [id])
  encounters Encounter[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledStart, scheduledEnd])
  @@map("appointments")
}

// =============================================================================
// CLINICAL ENCOUNTERS
// =============================================================================

model Encounter {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  doctorId        String   @map("doctor_id") @db.Uuid
  appointmentId   String?  @map("appointment_id") @db.Uuid
  status          String   @default("IN_PROGRESS") @db.VarChar(20)
  type            String   @default("OUTPATIENT") @db.VarChar(30)
  chiefComplaint  String?  @map("chief_complaint") @db.Text
  clinicalNotes   String?  @map("clinical_notes") @db.Text
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient       Patient       @relation(fields: [patientId], references: [id])
  doctor        Staff         @relation("DoctorEncounters", fields: [doctorId], references: [id])
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  vitalSigns    VitalSign[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  labOrders     LabOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("encounters")
}

model VitalSign {
  id            String   @id @default(uuid()) @db.Uuid
  encounterId   String   @map("encounter_id") @db.Uuid
  temperature   Float?   // Celsius
  bloodPressureSystolic  Int?  @map("bp_systolic")
  bloodPressureDiastolic Int?  @map("bp_diastolic")
  heartRate     Int?     @map("heart_rate")
  respiratoryRate Int?   @map("respiratory_rate")
  oxygenSaturation Float? @map("oxygen_saturation")
  weight        Float?   // kg
  height        Float?   // cm
  bmi           Float?
  notes         String?  @db.Text
  recordedBy    String   @map("recorded_by") @db.Uuid
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
  @@map("vital_signs")
}

// =============================================================================
// DIAGNOSES
// =============================================================================

model Diagnosis {
  id            String   @id @default(uuid()) @db.Uuid
  encounterId   String   @map("encounter_id") @db.Uuid
  code          String   @db.VarChar(20)  // ICD-10 style code
  description   String   @db.VarChar(500)
  type          String   @default("PRIMARY") @db.VarChar(20) // PRIMARY, SECONDARY, DIFFERENTIAL
  severity      String?  @db.VarChar(20) // MILD, MODERATE, SEVERE
  notes         String?  @db.Text
  diagnosedBy   String   @map("diagnosed_by") @db.Uuid
  diagnosedAt   DateTime @default(now()) @map("diagnosed_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
  @@index([code])
  @@map("diagnoses")
}

// =============================================================================
// PRESCRIPTIONS & MEDICATIONS
// =============================================================================

model MedicationCatalog {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  genericName     String?  @map("generic_name") @db.VarChar(255)
  category        String?  @db.VarChar(100)
  form            String?  @db.VarChar(50) // TABLET, CAPSULE, INJECTION, etc.
  strength        String?  @db.VarChar(50) // e.g., "500mg"
  manufacturer    String?  @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  prescriptionItems PrescriptionItem[]

  @@index([name])
  @@index([genericName])
  @@map("medication_catalog")
}

model Prescription {
  id            String   @id @default(uuid()) @db.Uuid
  encounterId   String   @map("encounter_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  prescriberId  String   @map("prescriber_id") @db.Uuid
  status        String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, DISPENSED, CANCELLED
  notes         String?  @db.Text
  prescribedAt  DateTime @default(now()) @map("prescribed_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  encounter  Encounter          @relation(fields: [encounterId], references: [id])
  patient    Patient             @relation(fields: [patientId], references: [id])
  prescriber Staff               @relation("PrescriberRelation", fields: [prescriberId], references: [id])
  items      PrescriptionItem[]

  @@index([patientId])
  @@index([encounterId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String   @id @default(uuid()) @db.Uuid
  prescriptionId  String   @map("prescription_id") @db.Uuid
  medicationId    String   @map("medication_id") @db.Uuid
  dosage          String   @db.VarChar(100)
  frequency       String   @db.VarChar(100)
  duration        String   @db.VarChar(100)
  route           String?  @db.VarChar(50) // ORAL, IV, etc.
  instructions    String?  @db.Text
  quantity        Int?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  prescription Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   MedicationCatalog @relation(fields: [medicationId], references: [id])

  @@map("prescription_items")
}

// =============================================================================
// LABORATORY
// =============================================================================

model LaboratoryTest {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  code            String   @unique @db.VarChar(20)
  category        String   @db.VarChar(100)
  description     String?  @db.Text
  unit            String?  @db.VarChar(50)
  referenceMin    Float?   @map("reference_min")
  referenceMax    Float?   @map("reference_max")
  referenceRange  String?  @map("reference_range") @db.VarChar(100)
  sampleType      String?  @map("sample_type") @db.VarChar(50) // BLOOD, URINE, etc.
  turnaroundHours Int?     @map("turnaround_hours")
  price           Float?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  labOrderItems LabOrderItem[]

  @@index([code])
  @@index([category])
  @@map("laboratory_tests")
}

model LabOrder {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  encounterId   String?  @map("encounter_id") @db.Uuid
  orderedBy     String   @map("ordered_by") @db.Uuid
  status        String   @default("ORDERED") @db.VarChar(20) // ORDERED, SPECIMEN_COLLECTED, PROCESSING, COMPLETED, CANCELLED
  priority      String   @default("ROUTINE") @db.VarChar(20)
  clinicalNotes String?  @map("clinical_notes") @db.Text
  orderedAt     DateTime @default(now()) @map("ordered_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient  Patient        @relation(fields: [patientId], references: [id])
  encounter Encounter?    @relation(fields: [encounterId], references: [id])
  items    LabOrderItem[]

  @@index([patientId])
  @@index([status])
  @@map("lab_orders")
}

model LabOrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  labOrderId    String   @map("lab_order_id") @db.Uuid
  testId        String   @map("test_id") @db.Uuid
  status        String   @default("PENDING") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  labOrder   LabOrder       @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  test       LaboratoryTest @relation(fields: [testId], references: [id])
  result     LabResult?

  @@map("lab_order_items")
}

model LabResult {
  id              String   @id @default(uuid()) @db.Uuid
  labOrderItemId  String   @unique @map("lab_order_item_id") @db.Uuid
  value           String   @db.VarChar(255)
  numericValue    Float?   @map("numeric_value")
  unit            String?  @db.VarChar(50)
  referenceRange  String?  @map("reference_range") @db.VarChar(100)
  isAbnormal      Boolean  @default(false) @map("is_abnormal")
  abnormalFlag    String?  @map("abnormal_flag") @db.VarChar(10) // HIGH, LOW, CRITICAL
  notes           String?  @db.Text
  performedBy     String   @map("performed_by") @db.Uuid
  validatedBy     String?  @map("validated_by") @db.Uuid
  validatedAt     DateTime? @map("validated_at") @db.Timestamptz
  resultedAt      DateTime @default(now()) @map("resulted_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  labOrderItem LabOrderItem @relation(fields: [labOrderItemId], references: [id])

  @@map("lab_results")
}

// =============================================================================
// BILLING
// =============================================================================

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(20)
  status        String   @default("DRAFT") @db.VarChar(20) // DRAFT, ISSUED, PAID, PARTIALLY_PAID, CANCELLED, OVERDUE
  subtotal      Float    @default(0)
  taxRate       Float    @default(0) @map("tax_rate")
  taxAmount     Float    @default(0) @map("tax_amount")
  discountAmount Float   @default(0) @map("discount_amount")
  totalAmount   Float    @default(0) @map("total_amount")
  paidAmount    Float    @default(0) @map("paid_amount")
  dueDate       DateTime? @map("due_date") @db.Date
  notes         String?  @db.Text
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz
  issuedBy      String?  @map("issued_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient  Patient       @relation(fields: [patientId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([patientId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String   @db.VarChar(500)
  category    String   @db.VarChar(50) // CONSULTATION, LAB_TEST, MEDICATION, PROCEDURE
  quantity    Int      @default(1)
  unitPrice   Float    @map("unit_price")
  totalPrice  Float    @map("total_price")
  referenceId String?  @map("reference_id") @db.Uuid // links to appointment, lab order, etc.
  referenceType String? @map("reference_type") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  amount        Float
  method        String   @db.VarChar(30) // CASH, CARD, BANK_TRANSFER, INSURANCE
  reference     String?  @db.VarChar(100) // transaction reference
  status        String   @default("COMPLETED") @db.VarChar(20)
  notes         String?  @db.Text
  processedBy   String   @map("processed_by") @db.Uuid
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// =============================================================================
// CONSENT
// =============================================================================

model Consent {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  category    String   @db.VarChar(100) // TREATMENT, DATA_SHARING, RESEARCH, COMMUNICATION
  purpose     String   @db.VarChar(255)
  status      String   @default("GRANTED") @db.VarChar(20) // GRANTED, REVOKED, EXPIRED
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  patient  Patient          @relation(fields: [patientId], references: [id])
  history  ConsentHistory[]

  @@index([patientId])
  @@index([category, status])
  @@map("consents")
}

model ConsentHistory {
  id        String   @id @default(uuid()) @db.Uuid
  consentId String   @map("consent_id") @db.Uuid
  action    String   @db.VarChar(20) // GRANTED, REVOKED, RENEWED, EXPIRED
  actorId   String   @map("actor_id") @db.Uuid
  reason    String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  consent Consent @relation(fields: [consentId], references: [id])

  @@index([consentId])
  @@map("consent_history")
}

// =============================================================================
// AUDIT LOGGING
// =============================================================================

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(50) // CREATE, READ, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  resourceType String   @map("resource_type") @db.VarChar(50) // PATIENT, APPOINTMENT, etc.
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  outcome      String   @default("SUCCESS") @db.VarChar(20) // SUCCESS, FAILURE, DENIED
  reason       String?  @db.Text
  metadata     Json?
  requestId    String?  @map("request_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50) // APPOINTMENT_CONFIRMATION, APPOINTMENT_REMINDER, LAB_RESULT, BILLING
  title     String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationJob {
  id              String   @id @default(uuid()) @db.Uuid
  type            String   @db.VarChar(50) // EMAIL, SMS, PUSH
  recipientId     String   @map("recipient_id") @db.Uuid
  channel         String   @db.VarChar(20) // email, sms
  subject         String?  @db.VarChar(255)
  body            String   @db.Text
  status          String   @default("PENDING") @db.VarChar(20) // PENDING, SENT, FAILED, RETRYING
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3) @map("max_attempts")
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz
  errorMessage    String?  @map("error_message") @db.Text
  idempotencyKey  String?  @unique @map("idempotency_key") @db.VarChar(100)
  scheduledFor    DateTime? @map("scheduled_for") @db.Timestamptz
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([scheduledFor])
  @@map("notification_jobs")
}

// =============================================================================
// FHIR INTEGRATION
// =============================================================================

model FhirSyncRecord {
  id              String   @id @default(uuid()) @db.Uuid
  resourceType    String   @map("resource_type") @db.VarChar(50)
  localId         String   @map("local_id") @db.VarChar(100)
  fhirId          String?  @map("fhir_id") @db.VarChar(100)
  direction       String   @db.VarChar(10) // IMPORT, EXPORT
  status          String   @default("PENDING") @db.VarChar(20) // PENDING, SUCCESS, FAILED
  errorMessage    String?  @map("error_message") @db.Text
  payload         Json?
  syncedAt        DateTime? @map("synced_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([resourceType, localId])
  @@index([status])
  @@map("fhir_sync_records")
}

// =============================================================================
// IDEMPOTENCY
// =============================================================================

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(255)
  response    Json?
  statusCode  Int?     @map("status_code")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
