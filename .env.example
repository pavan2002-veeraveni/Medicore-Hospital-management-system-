# =============================================================================
# MediCore Hospital Management Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=MediCore
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=MediCore

# -----------------------------------------------------------------------------
# Backend API (Express.js)
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0

# JWT Configuration
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Request Limits
MAX_REQUEST_SIZE=10mb

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://medicore_user:medicore_password@localhost:5432/medicore_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Python Analytics Service (FastAPI)
# -----------------------------------------------------------------------------
ANALYTICS_PORT=8000
ANALYTICS_HOST=0.0.0.0
ANALYTICS_API_KEY=change-this-to-a-secure-api-key
ANALYTICS_DATABASE_URL=postgresql://medicore_readonly:readonly_password@localhost:5432/medicore_db

# -----------------------------------------------------------------------------
# Email (Sandbox - Mailtrap or similar)
# -----------------------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-username
SMTP_PASS=your-mailtrap-password
SMTP_FROM=noreply@medicore.local

# -----------------------------------------------------------------------------
# SMS (Sandbox)
# -----------------------------------------------------------------------------
SMS_PROVIDER=sandbox
SMS_API_KEY=sandbox-api-key
SMS_FROM=+1234567890

# -----------------------------------------------------------------------------
# FHIR Integration
# -----------------------------------------------------------------------------
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_AUTH_TOKEN=
FHIR_TIMEOUT_MS=30000
FHIR_RETRY_ATTEMPTS=3
FHIR_RETRY_DELAY_MS=1000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Docker Compose Overrides
# -----------------------------------------------------------------------------
POSTGRES_USER=medicore_user
POSTGRES_PASSWORD=medicore_password
POSTGRES_DB=medicore_db
POSTGRES_PORT=5432
