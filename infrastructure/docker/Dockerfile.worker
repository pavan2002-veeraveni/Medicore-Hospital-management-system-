# =============================================================================
# MediCore Worker - Dockerfile
# =============================================================================
# BullMQ background job worker

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app/backend/api

FROM base AS deps
RUN apk add --no-cache python3 make g++
COPY backend/api/package.json ./
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

FROM base AS builder
RUN apk add --no-cache python3 make g++
COPY backend/api/package.json ./
RUN npm install --no-audit --no-fund
COPY backend/api/ ./
COPY database/ /app/database/
RUN npx prisma generate
RUN npm run build

FROM base AS runner
WORKDIR /app/backend/api

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 medicore

COPY --from=deps /app/backend/api/node_modules ./node_modules
COPY --from=builder /app/backend/api/dist ./dist
COPY --from=builder /app/database /app/database
COPY --from=builder /app/backend/api/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/backend/api/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/backend/api/package.json ./package.json

USER medicore

CMD ["node", "dist/jobs/worker.js"]
